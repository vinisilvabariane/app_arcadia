# Copie para .env.local se quiser mudar algo no desenvolvimento.

# URL do Web App do Apps Script que lista as pastas do Drive.
# Se ficar em branco, vale a URL padrão de src/lib/api.ts.
VITE_API_URL=

# 1 = usa os dados de exemplo (src/data/mock.ts) em vez do Drive.
VITE_USE_MOCK=0

# Chave de API do Google (Drive API) para o "Jogar no navegador".
# Em branco = recurso desligado. Tambem pode ser fixada em src/data/play.ts.
VITE_DRIVE_API_KEY=

# So no npm run dev: arquivo local usado no lugar do Drive, pra testar o "Jogar" sem chave.
# Ex.: VITE_PLAY_DEV_ROM=_poc/snes.zip (com a ROM em public/_poc/)
VITE_PLAY_DEV_ROM=
